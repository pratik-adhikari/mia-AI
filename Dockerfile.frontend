FROM node:22-alpine AS dependencies

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:22-alpine AS builder

ARG NEXT_PUBLIC_MIA_API_URL=http://127.0.0.1:8000
ARG NEXT_PUBLIC_MIA_GRAPH_DEBUG_ENABLED=false
ARG NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
ENV NEXT_TELEMETRY_DISABLED=1 \
    NEXT_PUBLIC_MIA_API_URL=${NEXT_PUBLIC_MIA_API_URL} \
    NEXT_PUBLIC_MIA_GRAPH_DEBUG_ENABLED=${NEXT_PUBLIC_MIA_GRAPH_DEBUG_ENABLED} \
    NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=${NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY}

WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY package.json package-lock.json ./
COPY config.json ./config.json
COPY eslint.config.mjs next-env.d.ts next.config.mjs postcss.config.mjs tailwind.config.ts tsconfig.json ./
COPY proxy.ts ./proxy.ts
COPY app ./app
COPY components ./components
COPY lib ./lib
COPY workflows ./workflows
RUN npm run build && npm prune --omit=dev

FROM node:22-alpine AS runtime

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1

WORKDIR /app
COPY --from=builder --chown=node:node /app/package.json /app/package-lock.json ./
COPY --from=builder --chown=node:node /app/node_modules ./node_modules
COPY --from=builder --chown=node:node /app/.next ./.next
COPY --from=builder --chown=node:node /app/next.config.mjs ./next.config.mjs
COPY --from=builder --chown=node:node /app/config.json ./config.json

USER node

EXPOSE 3000

CMD ["sh", "-c", "exec npm run start -- --hostname ${MIA_BIND_HOST:-0.0.0.0} --port ${PORT:-3000}"]
