# Required for semantic mapping and ambiguous product discovery.
OPENROUTER_API_KEY=sk-or-...
MIA_AGENT_MODEL=deepseek/deepseek-v3.2

# Experimental Jev-first semantic routing. Disabled by default and shadow-only:
# it records routing diagnostics but cannot change mapping/AAS output yet.
# MIA_JEV_SHADOW_ENABLED=true
# MIA_JEV_MODEL=typesafe/jev-1.13
# MIA_JEV_MAX_CONCURRENCY=8
# Shadow decision-policy thresholds. These can be retuned without rerunning Jev.
# MIA_JEV_AUTO_MIN_SELECTED_PROBABILITY=0.80
# MIA_JEV_AUTO_MIN_MARGIN=0.75
# MIA_JEV_AUTO_MAX_RUNNER_UP_RATIO=0.12
# MIA_JEV_AUTO_MAX_ENTROPY=0.45
# MIA_JEV_OPTIONAL_MIN_SELECTED_PROBABILITY=0.70
# MIA_JEV_OPTIONAL_MIN_MARGIN=0.45
# MIA_JEV_OPTIONAL_MAX_RUNNER_UP_RATIO=0.15
# MIA_JEV_OPTIONAL_MAX_ENTROPY=0.65
# Lossless semantic grouping experiments.
# MIA_JEV_GROUPING_MAX_GROUPS=200

# Optional LangSmith tracing for local backend, worker, and Studio graph runs.
# Add your key locally to .env.local; traces may contain workflow inputs and outputs.
# LANGSMITH_API_KEY=lsv2-...
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=mia-local

# Local Agent Server used by FastAPI graph runs and LangGraph Studio.
# AGENT_SERVER_PORT=2025

# Clerk authenticates frontend routes and the Python API. Keep secret values server-side.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Optional PEM public key avoids a network JWKS lookup in the Python service.
# CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----..."
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,https://your-project.vercel.app

# Local persistence defaults to .mia-data/ and needs no configuration.
# MIA_LOCAL_MODE=1 forces SQLite/filesystem persistence and ignores stale PostgreSQL/Vercel
# storage variables that may still be present in .env.local.
# MIA_LOCAL_MODE=1
# Local Docker Compose forces filesystem artifact storage even if this file contains old Vercel
# variables, and runs background crawl/research through a persistent local worker.
# MIA_CATALOGUE_PATH=.mia-data/catalogue.sqlite3
# MIA_THREAD_STORE_PATH=.mia-data/mia-agent.sqlite3
# MIA_WORKSPACE_ROOT=.mia-data/workspaces

# Production/Vercel: durable PostgreSQL metadata/checkpoints are required.
# Supabase works through its PostgreSQL pooler URL; DATABASE_URL is accepted too.
# MIA_DATABASE_URL=postgresql://user:password@aws-0-region.pooler.supabase.com:6543/postgres
# MIA_BACKEND_URL=http://127.0.0.1:8000  # local Next.js BFF -> Python backend
# A connected Vercel Blob store supplies BLOB_READ_WRITE_TOKEN automatically.
# BLOB_READ_WRITE_TOKEN=vercel_blob_...

# Shared only by Vercel Workflow steps and the Python worker endpoint.
MIA_WORKFLOW_SECRET=replace-with-a-long-random-secret

# Optional local worker tuning.
# MIA_WORKER_POLL_SECONDS=1
